# Environment mode: "local" atau "production"
# Jika diatur ke "production", tombol dan endpoint pendaftaran user baru (/register) akan diblokir
APP_ENV=local

# Port aplikasi
APP_PORT=8080

# Konfigurasi Koneksi MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=github_webhook

# Default Global Webhook Secret (jika di tabel repositories webhook_secret kosong)
GLOBAL_WEBHOOK_SECRET=your_global_secret_key_here

# Retensi penyimpanan log eksekusi di database (dalam satuan hari)
# Contoh: 7 berarti log yang lebih lama dari 7 hari otomatis dihapus dari database
LOG_RETENTION_DAYS=7

# Konfigurasi Telegram Bot Notifier (Opsional)
# Buat bot via @BotFather di Telegram untuk mendapatkan bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
